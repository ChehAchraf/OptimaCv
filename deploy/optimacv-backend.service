[Unit]
Description=OptimaCV Backend API Service
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/optimacv
Environment="PATH=/opt/optimacv/venv/bin"
ExecStart=/opt/optimacv/venv/bin/uvicorn backend.main:app --host 0.0.0.0 --port 8000 --workers 4
Restart=always
RestartSec=10

# Security settings
NoNewPrivileges=true
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=optimacv-backend

[Install]
WantedBy=multi-user.target

