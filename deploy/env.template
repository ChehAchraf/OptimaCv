# OptimaCV Environment Configuration
# Copy this file to .env in the project root and fill in your values

# ============================================
# AI Provider Configuration
# ============================================
# Choose one: "ollama" or "gemini"
AI_PROVIDER=ollama

# ============================================
# Ollama Configuration (if AI_PROVIDER=ollama)
# ============================================
# If Ollama is running on the same server:
OLLAMA_HOST=http://localhost:11434
# If Ollama is running on a different server:
# OLLAMA_HOST=http://your-ollama-server-ip:11434

OLLAMA_MODEL=gemma3:4b

# ============================================
# Gemini Configuration (if AI_PROVIDER=gemini)
# ============================================
GOOGLE_API_KEY=your_google_api_key_here

# ============================================
# Server Configuration
# ============================================
# Backend port (default: 8000)
BACKEND_PORT=8000

# Frontend port (default: 3000)
FRONTEND_PORT=3000

# ============================================
# Domain Configuration (for CORS)
# ============================================
# Replace with your actual domain
DOMAIN=http://your-domain.com
# Or if using IP:
# DOMAIN=http://your-server-ip

# CORS Origins (comma-separated list)
# Add all domains/IPs that should access the API
CORS_ORIGINS=http://your-domain.com,http://www.your-domain.com,http://your-server-ip
# For development, you can also include:
# CORS_ORIGINS=http://localhost:3000,http://localhost,http://your-domain.com

